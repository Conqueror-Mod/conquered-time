{
  "name": "conquered-time-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Discord bot for the Conquered Time beta community — beta keys, welcome/roles, bug & feedback intake, release announcements.",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "deploy": "tsx src/deploy-commands.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
