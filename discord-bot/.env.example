# ── Conquered Time beta bot — configuration ──────────────────────────────────
# Copy this file to `.env` and fill in the values. `.env` is gitignored.
# IDs: enable Developer Mode in Discord (Settings → Advanced), then right-click
# a server / channel / role → "Copy ID".

# ── Required: bot identity ───────────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications → your app → Bot.
DISCORD_TOKEN=
# Application (client) ID — the app's "General Information" → Application ID.
DISCORD_CLIENT_ID=
# Your beta server's ID. Slash commands register instantly to this one guild.
DISCORD_GUILD_ID=

# ── Roles ────────────────────────────────────────────────────────────────────
# Role assigned to members on join (create a "Beta Tester" role first).
BETA_ROLE_ID=
# Role allowed to run admin commands like /mintkeys (e.g. your Staff/Admin role).
ADMIN_ROLE_ID=
# OPTIONAL: if set, only members with this role may run /betakey. Leave blank to
# allow everyone in the server.
BETA_KEY_ROLE_ID=

# ── Channels ─────────────────────────────────────────────────────────────────
# Where the welcome message is posted (leave blank to welcome via DM only).
WELCOME_CHANNEL_ID=
# Where /bug reports are posted.
BUG_CHANNEL_ID=
# Where /feedback is posted.
FEEDBACK_CHANNEL_ID=
# Where new-release announcements are posted.
ANNOUNCE_CHANNEL_ID=

# ── Beta keys ────────────────────────────────────────────────────────────────
# Expiry date (UTC) baked into minted keys — keys work through the END of this
# day. Format YYYY-MM-DD.
BETA_KEY_EXPIRY=2026-12-31
# NOTE: the signing secret is NOT set here. The bot reads the app's shared
# secret from ../src/shared/beta-secret.js (same file the app uses). If that
# file is missing, key commands are disabled with a clear message.

# ── Release announcements ────────────────────────────────────────────────────
# GitHub repo to watch for new releases (owner/name).
GITHUB_REPO=Conqueror-Mod/conquered-time
# OPTIONAL but REQUIRED IF THE REPO IS PRIVATE: a GitHub token with read access
# so the bot can see releases/version.json. A fine-grained token with
# "Contents: Read-only" on this repo is enough. Without it, a private repo
# returns 404 and announcements/`/version` silently no-op.
GITHUB_TOKEN=
# How often to poll GitHub for a new release, in minutes (default 10).
RELEASE_POLL_MINUTES=10
