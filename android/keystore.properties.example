# Copy to keystore.properties (gitignored) and fill in your own values.
# keystore.properties + the .jks file are the app's signing secret — back them
# up privately (like src/shared/beta-secret.js). If lost, you can never ship an
# update that overwrites an already-installed copy of this exact signing identity.
#
# Paths are resolved relative to the android/ project root.
# With a PKCS12 keystore (recommended), storePassword and keyPassword are the
# SAME value. keyAlias must match keytool's -alias.
storeFile=conquered-time-release.jks
storePassword=CHANGE_ME
keyAlias=conquered-time
keyPassword=CHANGE_ME
