{
  // Phase 2 of the TypeScript refactor (docs/refactor-plan.md): compile the
  // main process to dist-main/. rootDir "src" preserves directory depth, so
  // every ../.. relative path in main.ts (assets, dev-data) still resolves,
  // and the .js modules main.ts requires (vault-crypto, read-cache, beta-keys,
  // beta-secret, row-utils) are copied alongside via allowJs.
  //
  // dist-main/
  // ├── main/       main.js, preload.js, vault-crypto.js, read-cache.js, beta-keys.js
  // ├── shared/     beta-secret.js (gitignored source; absent on fresh clones — gate fails open)
  // └── renderer/   row-utils.js, time-parse.js (shared helpers required by main)
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "Node16",
    "moduleResolution": "Node16",
    "allowJs": true,
    "checkJs": false,
    // strict applies to the .ts files only (the remaining .js passthroughs are
    // not checked — checkJs stays off here; the root tsconfig covers them).
    "strict": true,
    // Keep `catch (e) { e.message }` working — the codebase's error handling
    // idiom predates useUnknownInCatchVariables and rewriting every catch to
    // narrow `unknown` adds noise without safety (errors here are Error-shaped).
    "useUnknownInCatchVariables": false,
    "outDir": "dist-main",
    "rootDir": "src",
    "types": ["node"],
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/main/**/*",
    "src/shared/**/*",
    "src/renderer/row-utils.js",
    "src/renderer/time-parse.js"
  ],
  "exclude": ["node_modules", "dist", "dist-main"]
}
