node_modules/
# build/ is electron-builder's resources dir — ignore everything except the
# tracked installer source files the build depends on.
build/*
!build/license.txt
!build/installer.nsh
dist/
# Compiled main process (tsc -p tsconfig.main.json) — generated, never commit.
dist-main/
dev-data/
*.db
*.db-backup-*
.env
.claude/settings.local.json
.tmp-shots/
# Private beta-key signing secret — never commit (example template IS tracked).
src/shared/beta-secret.js
