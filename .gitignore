node_modules/
# build/ is electron-builder's resources dir — ignore everything except the
# tracked installer source files the build depends on.
build/*
!build/license.txt
!build/installer.nsh
dist/
# Compiled main process (tsc -p tsconfig.main.json) — generated, never commit.
dist-main/
# Phase 3: converted renderer pages compile .ts -> sibling .js (same filename
# the HTML references). The generated .js is never committed — one line per
# converted page; remove the source .js from git when converting.
src/renderer/pages/dashboard.js
src/renderer/pages/task-timer.js
dev-data/
*.db
*.db-backup-*
.env
.claude/settings.local.json
.tmp-shots/
# Private beta-key signing secret — never commit (example template IS tracked).
src/shared/beta-secret.js
src/renderer/pages/theme-init.js
src/renderer/pages/login-theme-init.js
src/renderer/pages/audit-theme-init.js
src/renderer/pages/splash.js
src/renderer/pages/global-log.js
src/renderer/pages/reports.js
